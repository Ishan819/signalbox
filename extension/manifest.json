{
  "manifest_version": 3,
  "name": "Signal for Gmail",
  "version": "0.1.0",
  "description": "Highlights the Gmail messages that actually need you, scored by your local signalbox server.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["match.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
